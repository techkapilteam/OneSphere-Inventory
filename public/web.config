<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <httpProtocol>
      <!-- Previously this file had no customHeaders/CORS block at all, which blocked
           every cross-origin request outright. The outboundRules block below now
           dynamically allows onesphere.kapilit.com, onesuite.kapilit.com and
           onesuite-uat.kapilit.com. -->
      <customHeaders>
        <!-- "null" placeholder (not an empty string) so the header exists in the response
             for the outboundRules rule below to rewrite. An empty string value here caused
             every subsequent customHeaders entry to shift onto the wrong header name. -->
        <add name="Access-Control-Allow-Origin" value="null" />
        <add name="Access-Control-Allow-Methods" value="GET, HEAD, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="*" />
        <!-- Tells any downstream/browser cache that the response varies by Origin,
             so one origin's cached CORS header is never reused for another. -->
        <add name="Vary" value="Origin" />
        <!-- onesuite.kapilit.com and onesuite-uat.kapilit.com share the same registrable
             domain (kapilit.com), so Chrome/Edge treat them as the same HTTP cache
             partition. Without this, the browser can reuse a response (CORS header
             baked in) fetched for one shell origin when the other shell asks for the
             same URL. no-store forces every request to hit the network fresh. -->
        <add name="Cache-Control" value="no-store, no-cache, must-revalidate" />
      </customHeaders>
    </httpProtocol>
    <!-- Kernel-mode caching serves the first-cached response (CORS header included)
         for every subsequent request to the same URL regardless of Origin, bypassing
         the outbound rewrite rule entirely. Disable it so every request re-runs the
         pipeline and gets its own origin reflected back. -->
    <caching enabled="true" enableKernelCache="false">
      <profiles>
        <add extension=".json" policy="DontCache" kernelCachePolicy="DontCache" />
        <add extension=".js" policy="DontCache" kernelCachePolicy="DontCache" />
        <add extension=".mjs" policy="DontCache" kernelCachePolicy="DontCache" />
      </profiles>
    </caching>
    <staticContent>
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <remove fileExtension=".js" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".woff"  mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <mimeMap fileExtension=".js"    mimeType="application/javascript" />
      <mimeMap fileExtension=".mjs"   mimeType="application/javascript" />
    </staticContent>
    <rewrite>
      <rules>
        <rule name="Angular Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile"      negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory"  negate="true" />
          </conditions>
          <action type="Rewrite" url="/" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Set CORS Allow-Origin" enabled="true">
          <match serverVariable="RESPONSE_Access_Control_Allow_Origin" pattern=".*" />
          <conditions>
            <add input="{HTTP_ORIGIN}" pattern="^https://(onesphere|onesuite|onesuite-uat)\.kapilit\.com$" />
          </conditions>
          <action type="Rewrite" value="{HTTP_ORIGIN}" />
        </rule>
      </outboundRules>
    </rewrite>
  </system.webServer>
</configuration>
